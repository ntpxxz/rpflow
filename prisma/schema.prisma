generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  role             UserRole          @default(Requester)
  password         String?
  userMail         String?           @map("user_mail")
  approvalSteps    ApprovalStep[]
  goodsReceipts    GoodsReceipt[]
  purchaseRequests PurchaseRequest[]
  historyEntries   RequestHistory[]

  @@map("users")
}

model PurchaseRequest {
  id            String           @id
  status        RequestStatus    @default(Pending)
  totalAmount   Decimal?         @map("total_amount")
  requesterName String
  type          RequestType
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  userId        String           @map("user_id")
  dueDate       DateTime?
  isOverBudget  Boolean          @default(false) @map("is_over_budget")
  items         RequestItem[]
  approvalSteps ApprovalStep[]
  user          User             @relation(fields: [userId], references: [id])
  history       RequestHistory[]

  @@map("purchase_requests")
}

model RequestItem {
  id                   String               @id @default(cuid())
  itemName             String
  detail               String?
  imageUrl             String?
  quantity             Int
  unitPrice            Decimal              @db.Decimal(10, 2)
  requestId            String
  quantityOrdered      Int                  @default(0) @map("quantity_ordered")
  isQuotationRequested Boolean              @default(false) @map("is_quotation_requested")
  rfqId                String?              @map("rfq_id")
  quotationNumber      String?              @map("quotation_number")
  quotedUnitPrice      Decimal?             @db.Decimal(10, 2) @map("quoted_unit_price")
  quotedAt             DateTime?            @map("quoted_at")
  request              PurchaseRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rfq                  RequestForQuotation? @relation(fields: [rfqId], references: [id])
  poItems              PurchaseOrderItem[]
}

model RequestForQuotation {
  id        String        @id @default(cuid())
  rfqNumber String        @unique @map("rfq_number")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  items     RequestItem[]

  @@map("request_for_quotations")
}

model ApprovalStep {
  id         String          @id @default(cuid())
  stepName   String          @map("step_name")
  status     ApprovalStatus  @default(Pending)
  comment    String?
  approvedAt DateTime?       @map("approved_at")
  requestId  String          @map("request_id")
  approverId String          @map("approver_id")
  approver   User            @relation(fields: [approverId], references: [id])
  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepName, approverId])
  @@map("approval_steps")
}

model RequestHistory {
  id        String          @id @default(cuid())
  action    String
  details   String?
  timestamp DateTime        @default(now())
  requestId String          @map("request_id")
  actorId   String          @map("actor_id")
  actor     User            @relation(fields: [actorId], references: [id])
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_history")
}

model PurchaseOrder {
  id        String              @id @default(cuid())
  poNumber  String              @unique @map("po_number")
  status    POStatus            @default(Pending)
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  receipts  GoodsReceipt[]
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String             @id @default(cuid())
  quantity        Int
  unitPrice       Decimal            @map("unit_price")
  poId            String             @map("po_id")
  detail          String?
  itemName        String
  requestItemId   String?            @map("request_item_id")
  imageUrl        String?
  quotationNumber String?
  receiptItems    GoodsReceiptItem[]
  po              PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  requestItem     RequestItem?       @relation(fields: [requestItemId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id           String             @id @default(cuid())
  notes        String?
  receivedAt   DateTime           @default(now()) @map("received_at")
  poId         String             @map("po_id")
  receivedById String             @map("received_by_id")
  items        GoodsReceiptItem[]
  po           PurchaseOrder      @relation(fields: [poId], references: [id])
  receivedBy   User               @relation(fields: [receivedById], references: [id])

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String            @id @default(cuid())
  quantityReceived Int               @map("quantity_received")
  receiptId        String            @map("receipt_id")
  poItemId         String            @map("po_item_id")
  poItem           PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  receipt          GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

model MonthlyBudget {
  id        String      @id @default(cuid())
  month     String
  amount    Decimal     @db.Decimal(15, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  type      RequestType @default(NORMAL)

  @@unique([month, type])
  @@map("monthly_budgets")
}

enum POStatus {
  Pending   @map("pending")
  Sent      @map("sent")
  Partial   @map("partial")
  Fulfilled @map("fulfilled")
  Cancelled @map("cancelled")
}

enum UserRole {
  Requester @map("requester")
  Approver  @map("approver")
  Purchaser @map("purchaser")
  Admin     @map("admin")
  User      @map("user")
}

enum RequestType {
  NORMAL
  URGENT
  PROJECT
}

enum RequestStatus {
  Pending           @map("pending")
  Approved          @map("approved")
  Ordered           @map("ordered")
  Received          @map("received")
  Rejected          @map("rejected")
  Cancelled         @map("cancelled")
  AwaitingQuotation @map("awaiting_quotation")
}

enum ApprovalStatus {
  Pending  @map("pending")
  Approved @map("approved")
  Rejected @map("rejected")
}
